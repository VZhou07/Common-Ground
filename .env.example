# 32 random bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_SECRET=

# The game is fully playable with the LLM off: the planner decides, templates
# write the hints, and handwritten lines cover the reactions.
LLM_ENABLED=false

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Confirmed against docs.anthropic.com/en/docs/about-claude/models/overview
VENN_THINK_MODEL=claude-sonnet-5-5
VENN_VOICE_MODEL=claude-haiku-4-5-20251001
VENN_PAIR_MODEL=claude-opus-5-5

# Without OPENAI_API_KEY the embedder falls back to a deterministic local
# word-vector, so every test and the whole game still run offline.
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=256
